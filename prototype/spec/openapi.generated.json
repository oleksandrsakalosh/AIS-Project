{
  "openapi": "3.1.0",
  "info": {
    "title": "POC-BOOKING-API",
    "version": "0.1.1"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/session": {
      "get": {
        "summary": "Session",
        "operationId": "session_session_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Login",
        "operationId": "login_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/logout": {
      "post": {
        "summary": "Logout",
        "operationId": "logout_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/trainings": {
      "get": {
        "summary": "Get Trainings",
        "operationId": "get_trainings_trainings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainingList"
                }
              }
            }
          }
        }
      }
    },
    "/memberships/current": {
      "get": {
        "summary": "Get Membership",
        "operationId": "get_membership_memberships_current_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembershipResponse"
                }
              }
            }
          }
        }
      }
    },
    "/reservations": {
      "get": {
        "summary": "Get Reservations",
        "operationId": "get_reservations_reservations_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationList"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Post Reservation",
        "operationId": "post_reservation_reservations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/reservations/{id_rezervacie}": {
      "delete": {
        "summary": "Delete Reservation",
        "operationId": "delete_reservation_reservations__id_rezervacie__delete",
        "parameters": [
          {
            "name": "id_rezervacie",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "title": "Id Rezervacie"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BookingInput": {
        "properties": {
          "id_klienta": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Id Klienta"
          },
          "id_treningu": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Id Treningu"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id_klienta",
          "id_treningu"
        ],
        "title": "BookingInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginInput": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginInput"
      },
      "MembershipResponse": {
        "properties": {
          "membership": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MembershipView"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "membership"
        ],
        "title": "MembershipResponse"
      },
      "MembershipView": {
        "properties": {
          "id_clenstva": {
            "type": "integer",
            "title": "Id Clenstva"
          },
          "typ": {
            "type": "string",
            "title": "Typ"
          },
          "stav": {
            "type": "string",
            "enum": [
              "active",
              "pending",
              "expired"
            ],
            "title": "Stav"
          },
          "valid_from": {
            "type": "string",
            "title": "Valid From"
          },
          "valid_until": {
            "type": "string",
            "title": "Valid Until"
          }
        },
        "type": "object",
        "required": [
          "id_clenstva",
          "typ",
          "stav",
          "valid_from",
          "valid_until"
        ],
        "title": "MembershipView"
      },
      "MutationResult": {
        "properties": {
          "id_rezervacie": {
            "type": "integer",
            "title": "Id Rezervacie"
          },
          "stav": {
            "type": "string",
            "enum": [
              "confirmed",
              "cancelled"
            ],
            "title": "Stav"
          }
        },
        "type": "object",
        "required": [
          "id_rezervacie",
          "stav"
        ],
        "title": "MutationResult"
      },
      "ReservationList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReservationView"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "ReservationList"
      },
      "ReservationView": {
        "properties": {
          "id_rezervacie": {
            "type": "integer",
            "title": "Id Rezervacie"
          },
          "id_treningu": {
            "type": "integer",
            "title": "Id Treningu"
          },
          "stav": {
            "type": "string",
            "enum": [
              "confirmed",
              "cancelled"
            ],
            "title": "Stav"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "cancelled_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cancelled At"
          },
          "training": {
            "$ref": "#/components/schemas/TrainingView"
          }
        },
        "type": "object",
        "required": [
          "id_rezervacie",
          "id_treningu",
          "stav",
          "created_at",
          "cancelled_at",
          "training"
        ],
        "title": "ReservationView"
      },
      "TrainingList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TrainingView"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "TrainingList"
      },
      "TrainingView": {
        "properties": {
          "id_treningu": {
            "type": "integer",
            "title": "Id Treningu"
          },
          "aktivita": {
            "type": "string",
            "title": "Aktivita"
          },
          "trener": {
            "type": "string",
            "title": "Trener"
          },
          "priestor": {
            "type": "string",
            "title": "Priestor"
          },
          "starts_at": {
            "type": "string",
            "title": "Starts At"
          },
          "ends_at": {
            "type": "string",
            "title": "Ends At"
          },
          "kapacita": {
            "type": "integer",
            "title": "Kapacita"
          },
          "obsadene": {
            "type": "integer",
            "title": "Obsadene"
          },
          "volne_miesta": {
            "type": "integer",
            "title": "Volne Miesta"
          },
          "moja_rezervacia_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Moja Rezervacia Id"
          }
        },
        "type": "object",
        "required": [
          "id_treningu",
          "aktivita",
          "trener",
          "priestor",
          "starts_at",
          "ends_at",
          "kapacita",
          "obsadene",
          "volne_miesta",
          "moja_rezervacia_id"
        ],
        "title": "TrainingView"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
